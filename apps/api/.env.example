# ==============================================================================
# TrustVault Backend API (apps/api) Environment Variables
# ==============================================================================

# Server Environment & Networking
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (Supabase PostgreSQL via Prisma)
# Session pooler (Port 5432 or 6543) or direct connection.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres?schema=trustvault"

# Clerk Authentication (obtained from Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Webhook Secret (optional: for syncing user events from Clerk Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase Storage Configuration (Private Buckets)
# Supabase Project URL and Service Role Key (used exclusively on backend for private storage)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trustvault-documents

# AI-Assisted Document Access Suggestions (Optional)
# Accepts Gemini API Key, Groq, or OpenAI API Key
AI_API_KEY=

# Initial Bootstrap Admin Provisioning
# Email of the initial user to automatically receive ADMIN role on first sign-in
BOOTSTRAP_ADMIN_EMAIL=

