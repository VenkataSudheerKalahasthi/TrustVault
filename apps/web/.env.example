# ==============================================================================
# TrustVault Frontend (apps/web) Environment Variables
# ==============================================================================
# Only browser-safe variables prefixed with VITE_ are exposed to the client bundle.
# Never place secret keys or database connection strings in this file.

# Clerk Authentication Publishable Key (obtained from Clerk Dashboard > API Keys)
# Format: pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=

# TrustVault Express API Base URL (defaults to /api when using Vite development proxy)
VITE_API_BASE_URL=/api/v1

