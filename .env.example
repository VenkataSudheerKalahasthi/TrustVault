# ==============================================================================
# TrustVault Monorepo Root Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or configure package-specific .env files:
#   - packages/database/.env
#   - apps/api/.env
#   - apps/web/.env
#   - apps/admin/.env

# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:REPLACE_WITH_NEW_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=trustvault"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_ID:REPLACE_WITH_NEW_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=trustvault"

# Supabase Storage & Service Key (Backend Only)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_NEW_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=trustvault-docs

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_NEW_CLERK_SECRET
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_NEW_CLERK_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_NEW_CLERK_KEY

# API & Networking
PORT=5001
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# Security & Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@trustvault.security
