# ==============================================================================
# TrustVault Backend API (apps/api/.env.example)
# ==============================================================================

# Server Environment & Networking
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:REPLACE_WITH_NEW_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=trustvault"

# Clerk Authentication (obtained from Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_NEW_CLERK_SECRET
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_NEW_CLERK_KEY

# Clerk Webhook Secret (optional: for syncing user events from Clerk Webhooks)
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_NEW_WEBHOOK_SECRET

# Supabase Storage & Administration (Private Buckets)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_NEW_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=trustvault-docs

# AI-Assisted Document Access Suggestions (Optional: Gemini or OpenAI API Key)
AI_API_KEY=

# Initial Bootstrap Admin & Allowed Admin Emails
BOOTSTRAP_ADMIN_EMAIL=admin@trustvault.security
ADMIN_EMAIL_ALLOWLIST=admin@trustvault.security,security@trustvault.io
